# Server-seitig (apps/api). Niemals ins Frontend oder in Git!
# Der Server wird für den Möbel-Import aus Online-Shops gebraucht (npm run dev startet ihn automatisch).
# IMPORT_ALLOW_PRIVATE=1 NUR für lokale Tests mit einem Fixture-Server – niemals in Produktion.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Basis-URL der Higgsfield-API (siehe docs/HIGGSFIELD.md)
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
HIGGSFIELD_SUBMIT_PATH=/v1/text2image/soul
HIGGSFIELD_STATUS_PATH=/v1/job-sets/{id}
# Öffentliche URL der API (Higgsfield lädt das Referenzbild von dort)
# PUBLIC_BASE_URL=https://api.example.com
# Externe Bild-KI ist optional: "none" (Standard – Fotos rendert die App selbst), "mock", "higgsfield"
RENDER_PROVIDER=none
PORT=8787
CORS_ORIGIN=http://localhost:5173
